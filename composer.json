{
    "name": "code8byte/php-toolkit",
    "description": "Small, dependency-free PHP helper functions for strings, currency, and text formatting.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Codebyte\\PhpToolkit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Codebyte\\PhpToolkit\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "scripts": {
        "test": "phpunit"
    }
}
